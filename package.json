{
  "name": "interview-assistant",
  "version": "1.0.0",
  "description": "Transparent AI Interview Assistant powered by Gemini",
  "author": "Hrishabh Gupta",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.interviewassistant.app",
    "productName": "Interview Assistant",
    "copyright": "Copyright © 2026 Hrishabh Gupta. All rights reserved.",

    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis-web",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],

      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "nsisWeb": {
      "appPackageUrl": "https://github.com/hrishabhguptapip/interview-assistant/releases/download/v1.0.0/",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "nsis": {

      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "warningsAsErrors": false,

      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Interview Assistant",
      "installerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "installerHeader": "assets/installerHeader.png",
      "installerSidebar": "assets/installerSidebar.bmp",
      "uninstallerSidebar": "assets/installerSidebar.bmp",
      "license": "LICENSE.txt",

      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": true
    }
  },








  "dependencies": {
    "koffi": "^2.16.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
